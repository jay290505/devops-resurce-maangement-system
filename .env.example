# Environment variables for DevOps Resource Management Platform
#
# ZERO CONFIGURATION MODE:
# If MONGODB_URI is left blank or not set (e.g. on Vercel), the application
# automatically runs in full Demo Mock Mode with rich pre-seeded data!
#
# Default Credentials (works in both Demo Mode and Local DB):
# Admin:            admin / admin (or admin@devopsplatform.local)
# DevOps Engineer:  devops / admin (or devops-eng@devopsplatform.local)
# Project Manager:  pm / admin (or pm-lead@devopsplatform.local)
# Viewer / Auditor: viewer / admin (or viewer@devopsplatform.local)

# (Optional) Remote MongoDB Atlas connection string for persistent cloud storage:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/devops-resource-management?retryWrites=true&w=majority

# JWT Authentication Secret Key (Default fallback already built-in):
JWT_SECRET=devops-resource-platform-secret-key-2026

# App URL:
NEXT_PUBLIC_APP_URL=http://localhost:3000
