# Example environment variables for local development
# Copy this file to .env.local and fill in the values for your machine.
# This project supports both MONGODB_URI and the older MONGO_URI name for compatibility.

# MongoDB connection string for local development
# Default local admin MongoDB user: username=admin, password=admin
MONGODB_URI=mongodb://admin:admin@127.0.0.1:27017/devops-resource-management?authSource=admin

# App login defaults for local testing
# Email: admin@devopsplatform.local or admin
# Password: admin
JWT_SECRET=devops-resource-platform-secret-key-2026

# Next.js local app URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
