# Example environment variables for local development
# Copy this to .env.local and fill in real values. Do NOT commit .env.local to git.

# MongoDB connection string with a default "admin" user for local testing:
# - Create the user in your local MongoDB if you haven't already (see README below)
# - Replace the database name (devops-db) if you use a different one
MONGO_URI=mongodb://admin:admin@127.0.0.1:27017/devops-db?authSource=admin

# Next.js dev URL (example)
NEXTAUTH_URL=http://localhost:3000
